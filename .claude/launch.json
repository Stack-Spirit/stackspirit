{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "baseline",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--bind", "127.0.0.1", "--directory", "design/baseline"],
      "port": 4173
    },
    {
      "name": "brand",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4174", "--bind", "127.0.0.1", "--directory", "design/brand"],
      "port": 4174
    },
    {
      "name": "desktop-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@stackspirit/desktop"],
      "env": { "VITE_SPIRIT_MOCK": "1", "VITE_SPIRIT_MOCK_SCENARIO": "busy" },
      "port": 1420
    }
  ]
