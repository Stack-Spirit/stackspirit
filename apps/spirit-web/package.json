{
  "name": "@stackspirit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only StackSpirit Web cockpit over the VOWP daemon HTTP/SSE API",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "build:e2e:read-only": "VITE_SPIRIT_MOCK=1 VITE_SPIRIT_MOCK_SCENARIO=fresh vite build --outDir dist-read-only --emptyOutDir",
    "build:e2e:stale": "VITE_SPIRIT_MOCK=1 VITE_SPIRIT_MOCK_SCENARIO=stale-cache vite build --outDir dist-stale --emptyOutDir"
  },
  "dependencies": {
    "@stackspirit/ui": "0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
